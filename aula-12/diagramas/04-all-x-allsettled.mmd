flowchart LR
    INICIO["Várias requisições<br/>independentes"] --> PERGUNTA{"Uma falha<br/>invalida o resultado<br/>inteiro?"}
    PERGUNTA -- "sim" --> ALL["Promise.all<br/>tudo ou nada"]
    PERGUNTA -- "não" --> SETTLED["Promise.allSettled<br/>aproveita o que deu certo"]
    ALL --> R1["cumpre com o array<br/>de valores, na ordem"]
    ALL --> E1["rejeita no primeiro erro"]
    SETTLED --> R2["sempre cumpre com<br/>{ status, value / reason }"]

    classDef conceito fill:#2563EB,stroke:#1D4ED8,color:#FFFFFF;
    classDef decisao fill:#D97706,stroke:#B45309,color:#FFFFFF;
    classDef estrutura fill:#7C3AED,stroke:#6D28D9,color:#FFFFFF;
    classDef resultado fill:#16A34A,stroke:#166534,color:#FFFFFF;
    classDef erro fill:#DC2626,stroke:#991B1B,color:#FFFFFF;
    class INICIO conceito;
    class PERGUNTA decisao;
    class ALL,SETTLED estrutura;
    class R1,R2 resultado;
    class E1 erro;
