flowchart TD
    subgraph MARGIN["Margin — espaço fora da borda"]
        direction TB
        subgraph BORDER["Border — linha ao redor da caixa"]
            direction TB
            subgraph PADDING["Padding — espaço interno"]
                direction TB
                CONTENT["Content<br/>(width / height do elemento)"]
            end
        end
    end

    classDef content fill:#2563EB,stroke:#1D4ED8,color:#FFFFFF;
    classDef padding fill:#16A34A,stroke:#166534,color:#FFFFFF;
    classDef border fill:#EA580C,stroke:#9A3412,color:#FFFFFF;
    classDef margin fill:#4B5563,stroke:#374151,color:#FFFFFF;
    class CONTENT content;
    class PADDING padding;
    class BORDER border;
    class MARGIN margin;
