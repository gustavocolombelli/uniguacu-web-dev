flowchart TD
    A["Duas regras miram<br/>o mesmo elemento"] --> B{"Alguma usa<br/>!important?"}
    B -->|Sim| C["Essa regra vence"]
    B -->|Não| D{"Alguma é<br/>style inline?"}
    D -->|Sim| C
    D -->|Não| E{"Alguma usa<br/>#id?"}
    E -->|Sim| C
    E -->|Não| F{"Alguma usa<br/>.classe?"}
    F -->|Sim| C
    F -->|Não| G{"Restam seletores<br/>de elemento (p, div...)?"}
    G -->|Sim| C
    G -->|Não| H["Empate: vence a regra<br/>declarada por último"]

    classDef inicio fill:#2563EB,stroke:#1D4ED8,color:#FFFFFF;
    classDef decisao fill:#D97706,stroke:#B45309,color:#FFFFFF;
    classDef vence fill:#16A34A,stroke:#166534,color:#FFFFFF;
    classDef empate fill:#4B5563,stroke:#374151,color:#FFFFFF;
    class A inicio;
    class B,D,E,F,G decisao;
    class C vence;
    class H empate;
