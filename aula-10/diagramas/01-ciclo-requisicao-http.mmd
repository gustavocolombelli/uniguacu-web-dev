flowchart LR
    C["JavaScript no navegador<br/>fetch(url)"] --> REQ["Requisição HTTP<br/>GET viacep.com.br/ws/.../json/"]
    REQ --> S["Servidor da API<br/>(ViaCEP)"]
    S --> RES["Resposta HTTP<br/>status 200 + corpo em texto JSON"]
    RES --> P["response.json()"]
    P --> OBJ["Objeto JavaScript<br/>{ logradouro, bairro, uf, ... }"]

    classDef cliente fill:#2563EB,stroke:#1D4ED8,color:#FFFFFF;
    classDef rede fill:#EDEDEB,stroke:#C9C8C2,color:#2C2C2A;
    classDef servidor fill:#7C3AED,stroke:#6D28D9,color:#FFFFFF;
    classDef resultado fill:#16A34A,stroke:#166534,color:#FFFFFF;
    class C cliente;
    class REQ,RES rede;
    class S servidor;
    class P,OBJ resultado;
